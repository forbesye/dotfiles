# PATH
export PATH="$HOME/.local/bin:$PATH"

# mise — runtime version manager (activates node/python/ruby, etc.)
eval "$(mise activate zsh)"

# completion system — must run before fzf-tab / any completion plugin
autoload -Uz compinit && compinit
# case-insensitive completion (macOS FS is case-insensitive): lowercase→any-case
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# fzf — fuzzy finder: Ctrl-R history, Ctrl-T files, Alt-C cd
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

source "/opt/homebrew/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh"
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /opt/homebrew/share/zsh-you-should-use/you-should-use.plugin.zsh
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# starship prompt (keep last so it wraps everything)
eval "$(starship init zsh)"
